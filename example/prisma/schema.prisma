datasource db {
  provider = "postgresql"
}

model Creator {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @unique
  email     String   @unique
  firstName String?  @map("firstname")
  lastName  String?  @map("lastname")
  createdAt DateTime @default(now()) @map("createdat") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updatedat") @db.Timestamp(6)
  posts     Post[]

  @@map("creator")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("createdat") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updatedat") @db.Timestamp(6)
  authorId  String   @map("authorid") @db.Uuid
  author    Creator  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([authorId])
  @@map("post")
}
